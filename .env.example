# LLM provider/model passed to langchain init_chat_model (defaults: openai / gpt-5.4-mini-2026-03-17)
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini-2026-03-17
# Only for OpenAI reasoning models (gpt-5*, o*): minimal | low | medium | high
LLM_REASONING_EFFORT=low
OPENAI_API_KEY=

# Optional: override the raw data directory (defaults to <repo>/data/raw)
# EMPORIO_DATA_DIR=
